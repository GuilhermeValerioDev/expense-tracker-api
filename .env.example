# Copy this file to .env and replace the values below.

# --- Application ---
# Generate a long random string (at least 32 characters) for production.
SECRET_KEY=replace-this-with-a-long-random-string-at-least-32-characters

# Lifetime of access tokens, in minutes (default: 30).
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (local development) ---
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/expense_tracker

# Tests run against a separate database on the same server: the database name
# below with a "_test" suffix. Set this to point somewhere else (e.g. in CI).
# TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/expense_tracker_test

# --- PostgreSQL container (Docker Compose) ---
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=expense_tracker

# --- Production Compose / Caddy ---
# Local production-style demo: http://localhost
# Production: api.example.com (Caddy obtains TLS automatically)
SITE_ADDRESS=http://localhost

# Optional: JSON list of allowed browser origins.
# CORS_ORIGINS=["https://app.example.com"]
